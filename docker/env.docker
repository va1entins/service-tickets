# Zmienne środowiskowe dla stosu Docker
# Skopiuj do .env i dostosuj wartości

APP_ENV=dev

# Nginx
NGINX_PORT=8080

# PostgreSQL
POSTGRES_DB=service_tickets
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Symfony DATABASE_URL (do .env projektu)
# DATABASE_URL="postgresql://app:secret@postgres:5432/service_tickets?serverVersion=16&charset=utf8"
# REDIS_URL=redis://redis:6379
